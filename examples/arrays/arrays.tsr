// arrays.tsr — arrays demo (number[] and string[])
// Covers: creation, indexing, indexed assignment, length,
// for over an array, function with array as parameter, linear search.

// ============================================================
// 1. Creation, indexing, and length
// ============================================================
let nums: number[] = [10, 20, 30, 40, 50];
print("nums.length: " + nums.length);       // 5
print("nums[0]: " + nums[0]);               // 10
print("nums[4]: " + nums[4]);               // 50

// ============================================================
// 2. Indexed assignment: nums[2] = 99
// ============================================================
nums[2] = 99;
print("nums[2] after assignment: " + nums[2]);  // 99

// ============================================================
// 3. Sum of all elements (classic traversal)
// ============================================================
let sum: number = 0;
for (let i: number = 0; i < nums.length; i = i + 1) {
    sum = sum + nums[i];
}
print("Sum: " + sum);   // 10+20+99+40+50 = 219

// ============================================================
// 4. Find the maximum
// ============================================================
let max: number = nums[0];
for (let i: number = 1; i < nums.length; i = i + 1) {
    if (nums[i] > max) {
        max = nums[i];
    }
}
print("Max: " + max);   // 99

// ============================================================
// 5. Array of strings + length by chars
// ============================================================
let words: string[] = ["arcis", "world", "arcis"];
print("words.length: " + words.length);                // 3
print("words[0].length: " + words[0].length);          // 5 (chars in "arcis")
print("words[2].length: " + words[2].length);          // 5 (chars in "arcis")

// ============================================================
// 6. Linear search: find index of an element
// ============================================================
function find(arr: number[], target: number): number {
    for (let i: number = 0; i < arr.length; i = i + 1) {
        if (arr[i] == target) {
            return i;
        }
    }
    return -1;
}

let data: number[] = [10, 20, 30, 40];
let pos1: number = find(data, 30);
let pos2: number = find(data, 99);
print("30 is at position " + pos1);   // 2
print("99 is at position " + pos2);   // -1 (not found)

// ============================================================
// 7. Array with initial size (Rust does not auto-extend;
//    `arr[i] = v` requires the index to exist, like in C++).
// ============================================================
let bucket: number[] = [0, 0, 0];
bucket[0] = 100;
bucket[1] = 200;
bucket[2] = 300;
print("bucket.length: " + bucket.length);                  // 3
print("bucket[0] + bucket[2] = " + (bucket[0] + bucket[2]));  // 400

// ============================================================
// 8. Count elements greater than X
// ============================================================
function countGreater(arr: number[], x: number): number {
    let count: number = 0;
    for (let i: number = 0; i < arr.length; i = i + 1) {
        if (arr[i] > x) {
            count = count + 1;
        }
    }
    return count;
}

let grades: number[] = [50, 75, 90, 60, 85];
let passing: number = countGreater(grades, 70);
print("Grades > 70: " + passing);   // 3

// ============================================================
// 9. Array methods: find, filter, map, reduce, pop, unshift
// ============================================================
function isPositive(x: number): boolean { return x > 0; }
function double(x: number): number { return x * 2; }
function add(a: number, b: number): number { return a + b; }

let mix: number[] = [-3, -1, 2, 5, 7, -10, 8];

// find: first element that matches the predicate
let first: number = mix.find(isPositive);
print("find: " + first);   // 2

// filter: new array with the elements that match
let positives: number[] = mix.filter(isPositive);
print("filter length: " + positives.length);   // 4 (2, 5, 7, 8)
print("filter[0]: " + positives[0]);           // 2

// map: new array with the transformation applied
let doubled: number[] = mix.map(double);
print("map length: " + doubled.length);         // 7
print("map[0]: " + doubled[0]);                 // -6

// reduce: accumulated value
let total: number = mix.reduce(add, 0);
print("reduce: " + total);   // 8 (sum: -3+-1+2+5+7-10+8)

// pop: removes and returns the last element
let last: number = mix.pop();
print("pop: " + last);                                // 8
print("after pop length: " + mix.length);            // 6

// unshift: inserts at the beginning
mix.unshift(99);
print("after unshift[0]: " + mix[0]);                 // 99
print("length: " + mix.length);                       // 7