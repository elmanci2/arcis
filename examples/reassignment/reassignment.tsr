// reassignment.tsr — verifies that a `let` variable can be reassigned

let counter: number = 0;
let accumulated: number = 0;

counter = counter + 1;
accumulated = accumulated + 10;
print(counter);
print(accumulated);

counter = counter * 2;
print(counter);

// Classic swap using a temporary variable
let a: number = 1;
let b: number = 2;
let tmp: number = a;
a = b;
b = tmp;
print(a);
print(b);

// Reassigning a string
let greeting: string = "Hello";
print(greeting);
greeting = "Goodbye";
print(greeting);