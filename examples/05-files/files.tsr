// 05_files.tsr — `sys.*` filesystem builtins.
//
// `sys` codegen is split into ten submodules (see
// `crates/arcis-codegen/src/sys/`):
//
//   Top-level `sys.X(args)`:
//     - `fs`      — readFile, writeFile, readBytes, writeBytes, appendFile,
//                   createFile, deleteFile, deleteDir, deleteDirAll, mkdir,
//                   listDir, copy, move, rename
//     - `path`    — exists, isFile, isDir, fileSize, fileInfo, absolute,
//                   relative, createSymlink, readLink
//     - `proc_env` — currentDir, changeDir, tempDir, homeDir, executablePath
//     - `process`  — process, exec, spawn, kill, currentPid, parentPid,
//                    processes
//
//   Sub-namespace `sys.<ns>.<method>(args)`:
//     - `env`     — get, set, delete, all  (environment variables)
//     - `os`      — name, version, arch, hostname, username, uptime,
//                   locale, cpuCount
//     - `memory`  — total, free, used, available
//     - `cpu`     — model, brand, frequency, usage, cores
//     - `gpu`     — list, name, vendor, memory
//     - `disk`    — list, free, used, total
//
// They are available without any `import`.
//
// Run with:
//   arcis run examples/05-files/files.tsr
//
// This example creates a temporary `arcis_fs_demo/` directory next to the
// binary, exercises every builtin family above, and cleans up.

let dir: string = "arcis_fs_demo";
let filePath: string = dir + "/note.txt";

// ------------------------------------------------------------
// 1. sys.args — program arguments
// ------------------------------------------------------------

let args: string[] = sys.args;
print("arg count: " + args.length);
if (args.length > 0) {
    print("first arg: " + args[0]);
}

// ------------------------------------------------------------
// 2. sys.mkdir — create a directory.
//    (We guard with `sys.exists` so re-running the example is safe.)
// ------------------------------------------------------------

if (!sys.exists(dir)) {
    sys.mkdir(dir);
    print("created dir: " + dir);
} else {
    print("dir already existed: " + dir);
}

// ------------------------------------------------------------
// 3. sys.writeFile — write a string to disk
// ------------------------------------------------------------

sys.writeFile(filePath, "Hello from Arcis!\nLine 2.\n");
print("wrote file: " + filePath);

// ------------------------------------------------------------
// 4. sys.exists — check whether a path exists
// ------------------------------------------------------------

print("file exists? " + sys.exists(filePath));
print("missing file exists? " + sys.exists("does-not-exist.txt"));

// ------------------------------------------------------------
// 5. sys.readFile — read the file back
// ------------------------------------------------------------

let content: string = sys.readFile(filePath);
print("--- content of " + filePath + " ---");
print(content);
print("--- end content ---");

// ------------------------------------------------------------
// 6. sys.listDir — list entries in a directory
// ------------------------------------------------------------

let entries: string[] = sys.listDir(dir);
print("entries in " + dir + ":");
for (let name of entries) {
    print("  " + name);
}

// ------------------------------------------------------------
// 7. sys.deleteFile — clean up the file we created.
//    (Removing a non-empty directory needs `std::fs::remove_dir`, which
//    `sys.deleteFile` does not currently wrap — so we leave the dir in
//    place. `rm -rf arcis_fs_demo` cleans it up.)
// ------------------------------------------------------------

sys.deleteFile(filePath);
print("deleted file: " + filePath);
print("file still exists? " + sys.exists(filePath));
print("dir still exists? " + sys.exists(dir) + " (left in place — rm -rf to remove)");

// ------------------------------------------------------------
// 8. New file operations: copy, fileSize, isFile, isDir, append,
//    move, createFile, deleteDir. Demonstrates the `sys` codegen split
//    into `fs` and `path` submodules.
// ------------------------------------------------------------

// Re-create the file we just deleted so the rest of the example has
// something to operate on.
sys.writeFile(filePath, "Hello (round 2).\n");

// 8a. sys.copy(src, dst) — duplicate the file.
let backup: string = filePath + ".bak";
sys.copy(filePath, backup);
print("copied to: " + backup);
print("backup exists? " + sys.exists(backup));

// 8b. sys.fileSize(p) → number (bytes), sys.isFile(p) / sys.isDir(p) → bool.
print("size of " + filePath + ": " + sys.fileSize(filePath));
print("is " + filePath + " a file? " + sys.isFile(filePath));
print("is " + dir + " a directory? " + sys.isDir(dir));

// 8c. sys.appendFile(p, text) — append a line.
sys.appendFile(filePath, "Appended line.\n");
print("--- after append ---");
print(sys.readFile(filePath));
print("--- end after append ---");

// 8d. sys.move(src, dst) — also exposed as sys.rename.
let moved: string = filePath + ".moved";
sys.move(filePath, moved);
print("moved to: " + moved + ", exists? " + sys.exists(moved));
print("original gone? " + !sys.exists(filePath));

// 8e. sys.createFile(p) — touch an empty file, then sys.deleteFile it.
let touched: string = dir + "/touched.txt";
sys.createFile(touched);
print("created empty file: " + touched + ", size=" + sys.fileSize(touched));
sys.deleteFile(touched);

// 8f. sys.fileInfo(p) → string summary.
print("fileInfo of " + moved + ": " + sys.fileInfo(moved));

// ------------------------------------------------------------
// 9. Environment / process queries: currentDir, tempDir, homeDir,
//    executablePath.
// ------------------------------------------------------------

print("--- environment ---");
print("currentDir: " + sys.currentDir());
print("tempDir:    " + sys.tempDir());
print("homeDir:    " + sys.homeDir());
print("executable: " + sys.executablePath());

// ------------------------------------------------------------
// 10. Path transformations + cleanup.
//     absolute() falls back to the literal path if the file does not
//     exist; relative() strips the cwd prefix when possible.
// ------------------------------------------------------------

print("absolute(./" + dir + "): " + sys.absolute("./" + dir));
print("relative(" + sys.currentDir() + "/" + dir + "): " + sys.relative(dir));

// 10a. sys.createSymlink(target, link) + sys.readLink.
let link: string = dir + "/note.moved.lnk";
sys.createSymlink(moved, link);
print("symlink? " + sys.exists(link) + ", points to: " + sys.readLink(link));
sys.deleteFile(link);

// 10b. Final cleanup: remove every file in the directory and the dir itself.
sys.deleteFile(backup);
sys.deleteFile(moved);
sys.deleteDir(dir);
print("dir removed? " + !sys.exists(dir));

// ------------------------------------------------------------
// 11. Process management (sys.process, sys.exec, sys.spawn,
//     sys.currentPid, sys.parentPid, sys.processes, sys.kill).
//     The return type of sys.process is the built-in `ArcisProcess`
//     struct (always emitted by the codegen root module).
// ------------------------------------------------------------

print("--- process demo ---");

// 11a. sys.process(cmd, args) — captures stdout, stderr and exit code.
let p = sys.process("echo", ["hi from arcis"]);
print("stdout:    [" + p.stdout + "]");
print("stderr:    [" + p.stderr + "]");
print("exitCode:  " + p.exitCode);

// 11b. sys.exec(cmd, args) — returns stdout as a string (lossy UTF-8).
let uname: string = sys.exec("uname", ["-s"]);
print("uname:     " + uname.trim());

// 11c. sys.currentPid / sys.parentPid.
print("currentPid: " + sys.currentPid());
print("parentPid:  " + sys.parentPid());

// 11d. sys.processes() — returns `pid=<n>;name=<s>` per process.
let procs: string[] = sys.processes();
print("process count: " + procs.length);
if (procs.length > 0) {
    print("first proc:    " + procs[0]);
}

// 11e. sys.spawn + sys.kill — spawn a long-running child, then kill it.
//     `sleep 30 &` would block; we use `sh -c "sleep 30"` so we get a
//     child PID we control.
let spawned: number = sys.spawn("sh", ["-c", "sleep 30"]);
print("spawned pid:   " + spawned);
sys.kill(spawned);
print("killed pid:    " + spawned);

// ------------------------------------------------------------
// 12. sys.env.* (environment variables). Distinct from sys.env.rs
//     (process queries).
// ------------------------------------------------------------

print("--- sys.env demo ---");
sys.env.set("ARCIS_EXAMPLE", "1");
print("ARCIS_EXAMPLE: " + sys.env.get("ARCIS_EXAMPLE"));
print("HOME (truncated): " + sys.env.get("HOME"));
let envVars: string[] = sys.env.all();
print("env var count: " + envVars.length);
sys.env.delete("ARCIS_EXAMPLE");

// ------------------------------------------------------------
// 13. sys.os.* (OS info).
// ------------------------------------------------------------

print("--- sys.os demo ---");
print("name:     " + sys.os.name());
print("arch:     " + sys.os.arch());
print("version:  " + sys.os.version().trim());
print("hostname: " + sys.os.hostname());
print("username: " + sys.os.username());
print("locale:   " + sys.os.locale());
print("cpuCount: " + sys.os.cpuCount());
print("uptime:   " + sys.os.uptime() + " s");

// ------------------------------------------------------------
// 14. sys.memory.* (Linux-first; 0 on other platforms).
// ------------------------------------------------------------

print("--- sys.memory demo ---");
print("total:     " + sys.memory.total() + " bytes");
print("free:      " + sys.memory.free() + " bytes");
print("used:      " + sys.memory.used() + " bytes");
print("available: " + sys.memory.available() + " bytes");

// ------------------------------------------------------------
// 15. sys.cpu.* (Linux-first; 0 on other platforms).
// ------------------------------------------------------------

print("--- sys.cpu demo ---");
print("model:     " + sys.cpu.model());
print("brand:     " + sys.cpu.brand());
print("frequency: " + sys.cpu.frequency() + " MHz");
print("cores:     " + sys.cpu.cores());
print("usage:     " + sys.cpu.usage() + " %");

// ------------------------------------------------------------
// 16. sys.gpu.* (Linux-first; 0 / empty on other platforms).
// ------------------------------------------------------------

print("--- sys.gpu demo ---");
let gpus: string[] = sys.gpu.list();
print("gpu count:  " + gpus.length);
if (gpus.length > 0) {
    print("gpu[0]:     " + gpus[0]);
}
print("gpu.name:   " + sys.gpu.name());
print("gpu.vendor: " + sys.gpu.vendor());
print("gpu.memory: " + sys.gpu.memory() + " bytes");

// ------------------------------------------------------------
// 17. sys.disk.* (cross-platform via `df`).
// ------------------------------------------------------------

print("--- sys.disk demo ---");
let disks: string[] = sys.disk.list();
print("disk count: " + disks.length);
if (disks.length > 0) {
    print("disks[0]:   " + disks[0]);
}
print("disk.free(/):  " + sys.disk.free("/") + " bytes");
print("disk.used(/):  " + sys.disk.used("/") + " bytes");
print("disk.total(/): " + sys.disk.total("/") + " bytes");

