// strings.tsr — métodos de string + for-of
// Cubre los 7 métodos string soportados y la iteración for-of sobre arrays.

// ============================================================
// 1. Métodos de transformación de case y whitespace
// ============================================================
let saludo: string = "Hola Mundo";
print("toUpperCase: " + saludo.toUpperCase());   // HOLA MUNDO
print("toLowerCase: " + saludo.toLowerCase());   // hola mundo

let con_espacios: string = "   hola   ";
print("trim: '" + con_espacios.trim() + "'");    // 'hola'

// ============================================================
// 2. Búsqueda y substrings
// ============================================================
print("substring(0,4): " + saludo.substring(0, 4));   // Hola
print("substring(5): " + saludo.substring(5, 10));    // Mundo
print("indexOf('Mundo'): " + saludo.indexOf("Mundo")); // 5
print("indexOf('xyz'): " + saludo.indexOf("xyz"));     // -1 (no encontrado)
print("includes('Mundo'): " + saludo.includes("Mundo")); // true
print("includes('xyz'): " + saludo.includes("xyz"));     // false

// ============================================================
// 3. Acceso por carácter
// ============================================================
print("charAt(0): " + saludo.charAt(0));   // H
print("charAt(5): " + saludo.charAt(5));   // M
print("charAt(99): '" + saludo.charAt(99) + "'"); // "" (fuera de rango)

// ============================================================
// 4. for-of: iteración sobre los elementos
// ============================================================
let nums: number[] = [10, 20, 30, 40];

// Suma con for-of
let total: number = 0;
for (let x of nums) {
    total = total + x;
}
print("Suma for-of: " + total);   // 100

// continue + for-of
let sin_20: number[] = [];
for (let n of nums) {
    if (n == 20) {
        continue;
    }
    sin_20.push(n);
}
print("Sin el 20: " + sin_20.length);   // 3 (10, 30, 40)

// break + for-of
let encontrado: number = -1;
for (let x of nums) {
    if (x == 30) {
        encontrado = x;
        break;
    }
}
print("Encontrado: " + encontrado);   // 30

// ============================================================
// 5. Combinación: procesar strings con métodos
// ============================================================
function normalizar(s: string): string {
    return s.trim().toLowerCase();
}

let input: string = "  HOLA  ";
let normalizado: string = normalizar(input);
print("Normalizado: '" + normalizado + "'");   // 'hola'
print("¿contiene 'hola'? " + normalizado.includes("hola"));   // true