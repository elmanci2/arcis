// objetos.tsr — objetos inline con structs nombrados
// Cubre: creación, lectura, asignación, dos tipos distintos.

// ============================================================
// 1. Objeto simple: dos campos (string + number)
// ============================================================
let persona: { nombre: string, edad: number } = {
    nombre: "Ana",
    edad: 30
};
print("Nombre: " + persona.nombre);   // "Ana"
print("Edad: " + persona.edad);       // 30

persona.edad = 31;
print("Nueva edad: " + persona.edad); // 31

// ============================================================
// 2. Objeto con tres campos heterogéneos (string + number + boolean)
// ============================================================
let config: { debug: boolean, max: number, label: string } = {
    debug: false,
    max: 100,
    label: "main"
};
print("Label: " + config.label);   // "main"
print("Max: " + config.max);       // 100

config.debug = true;
print("Debug ahora: " + config.debug);   // true

// ============================================================
// 3. Objetos como items dentro de arrays
// ============================================================
let puntos: { x: number, y: number }[] = [
    { x: 1, y: 2 },
    { x: 3, y: 4 },
    { x: 5, y: 6 }
];

for (let p of puntos) {
    print("Punto: (" + p.x + ", " + p.y + ")");
}

// ============================================================
// 4. Sumar coordenadas
// ============================================================
let totalX: number = 0;
let totalY: number = 0;
for (let p of puntos) {
    totalX = totalX + p.x;
    totalY = totalY + p.y;
}
print("Total X: " + totalX);   // 9
print("Total Y: " + totalY);   // 12

// ============================================================
// 5. Reasignar campos en array de objetos
// ============================================================
puntos[0].x = 100;
print("puntos[0].x = " + puntos[0].x);   // 100