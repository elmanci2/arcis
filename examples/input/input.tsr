// input.tsr — example of the `input()` builtin.
//
// `input()` reads one line of stdin and returns it as a `string`, with
// no trailing `\n` (it does `trim_end()` automatically). It is blocking
// and takes no arguments.
//
// Interactive use:
//   $ arcis run examples/input/input.tsr
//   What is your name? Arcis        ← the user types and presses Enter
//   Hello, Arcis!
//
// Piped use:
//   $ printf "Arcis\nhello world\n" | arcis run examples/input/input.tsr

print("What is your name?");
let name: string = input();
print("Hello, " + name + "!");

print("");
print("Say something:");
let phrase: string = input();
print("You said: \"" + phrase + "\"");
print("Your phrase has " + phrase.length + " characters.");