// strings.tsr — string methods + for-of
// Covers all 7 supported string methods and `for-of` iteration over arrays.

// ============================================================
// 1. Case and whitespace transforms
// ============================================================
let greeting: string = "Hello World";
print("toUpperCase: " + greeting.toUpperCase());   // HELLO WORLD
print("toLowerCase: " + greeting.toLowerCase());   // hello world

let with_spaces: string = "   hello   ";
print("trim: '" + with_spaces.trim() + "'");        // 'hello'

// ============================================================
// 2. Substrings and search
// ============================================================
print("substring(0,4): " + greeting.substring(0, 4));     // Hello
print("substring(5): " + greeting.substring(5, 10));    // World
print("indexOf('World'): " + greeting.indexOf("World")); // 5
print("indexOf('xyz'): " + greeting.indexOf("xyz"));     // -1 (not found)
print("includes('World'): " + greeting.includes("World")); // true
print("includes('xyz'): " + greeting.includes("xyz"));     // false

// ============================================================
// 3. Character access
// ============================================================
print("charAt(0): " + greeting.charAt(0));   // H
print("charAt(5): " + greeting.charAt(5));   // W
print("charAt(99): '" + greeting.charAt(99) + "'"); // "" (out of range)

// ============================================================
// 4. for-of: iterating over array elements
// ============================================================
let nums: number[] = [10, 20, 30, 40];

// Sum with for-of
let total: number = 0;
for (let x of nums) {
    total = total + x;
}
print("for-of sum: " + total);   // 100

// continue + for-of
let without_20: number[] = [];
for (let n of nums) {
    if (n == 20) {
        continue;
    }
    without_20.push(n);
}
print("Without 20: " + without_20.length);   // 3 (10, 30, 40)

// break + for-of
let found: number = -1;
for (let x of nums) {
    if (x == 30) {
        found = x;
        break;
    }
}
print("Found: " + found);   // 30

// ============================================================
// 5. Composition: process strings with chained methods
// ============================================================
function normalize(s: string): string {
    return s.trim().toLowerCase();
}

let input: string = "  HELLO  ";
let normalized: string = normalize(input);
print("Normalized: '" + normalized + "'");                  // 'hello'
print("Contains 'hello'? " + normalized.includes("hello")); // true