// Program entry point (by convention, `main.tsr`).
//
// Imports symbols from other modules using the same syntax as TypeScript:
//   - named imports:         { sumar, PI }
//   - import with alias:     { gritarFuerte as GRITAR }
//   - default import:        calcula
import { sumar, PI } from "mate";
import calcula from "mate";
import { gritarFuerte as GRITAR } from "texto";

print("PI = " + PI);
print("2 + 3 = " + sumar(2, 3));
print("calcula(10) = " + calcula(10)); // default export
print(GRITAR("hello"));