// Program entry point (by convention, `main.tsr`).
//
// Imports symbols from other modules using Python-style syntax:
//   - namespace import:       import mate
//   - named imports:          from mate import sumar, PI
//   - import with alias:      from texto import gritarFuerte as GRITAR
//   - default import:         from mate import default as calcula
from mate import sumar, PI;
from mate import default as calcula;
from texto import gritarFuerte as GRITAR;

print("PI = " + PI);
print("2 + 3 = " + sumar(2, 3));
print("calcula(10) = " + calcula(10)); // default export
print(GRITAR("hello"));
