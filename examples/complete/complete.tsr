// complete.tsr — kitchen-sink demo of everything Arcis implements
// Covers: let/const, functions, if/else, print, reassignment,
// recursion, arithmetic / comparison / logical operators, string
// concatenation, booleans, numbers, comments.

// 1. Variables with and without explicit type annotations
let name: string = "Language";
let version: number = 2026;
let active: boolean = true;
let pi = 3.14;  // inferred type from the literal

// 2. Constants (UPPER_CASE convention, as in TS)
const LIMIT: number = 100;
const GREETING: string = "Hello";

// 3. Simple function
function double(x: number): number {
    return x * 2;
}

// 4. Function with if/else
function classify(n: number): string {
    if (n < 0) {
        return "negative";
    } else {

        if (n == 0) {
            return "zero";
        } else {
            return "positive";
        }
    }
}

// 5. Recursive function: factorial
function factorial(n: number): number {
    if (n <= 1) {
        return 1;
    } else {
        return n * factorial(n - 1);
    }
}

// 6. Boolean function with several parameters and logic
function isOfAge(age: number, minimum: number): boolean {
    return age >= minimum && age > 0;
}

// 7. Logical AND combined with comparison
function passes(grade: number): boolean {
    return grade >= 70 && grade <= 100;
}

// 8. Unary negation
function isInvalid(x: number): boolean {
    return !(x >= 0 && x <= 100);
}

// 9. Arithmetic modulo
function isEven(n: number): boolean {
    return n % 2 == 0;
}

// === Main program ===

print(GREETING + " " + name);
print("Version: " + version);
print("Active: " + active);
print("PI: " + pi);
print("Limit: " + LIMIT);

// Calls to simple functions
let doubled: number = double(21);
print("Double 21 = " + doubled);

// If/else
let kind: string = classify(-5);
print("-5 is: " + kind);

kind = classify(0);
print("0 is: " + kind);

kind = classify(42);
print("42 is: " + kind);

// Recursion
let fact5: number = factorial(5);
print("5! = " + fact5);

let fact10: number = factorial(10);
print("10! = " + fact10);

// Booleans
let ofAge: boolean = isOfAge(25, 18);
print("Is 25 of age 18? " + ofAge);

ofAge = isOfAge(15, 18);
print("Is 15 of age 18? " + ofAge);

let ok: boolean = passes(85);
print("Passes with 85? " + ok);

let invalid: boolean = isInvalid(150);
print("Is 150 invalid? " + invalid);

let even: boolean = isEven(8);
print("Is 8 even? " + even);

even = isEven(7);
print("Is 7 even? " + even);

// Reassignment
let counter: number = 0;
counter = counter + 1;
counter = counter * 10;
print("Final counter: " + counter);

// Multi-line block comment
/* This demonstrates
   that block comments
   work correctly. */

// Multiple concatenation
let msg: string = "Double: " + doubled + " / Fact5: " + fact5;
print(msg);