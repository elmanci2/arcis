// loops.tsr — realistic demos of while, for, break, continue, .length
// Cada ejemplo resuelve un mini-problema, no solo exhibe la sintaxis.

// ============================================================
// 1. while: contar de 1 a 5 con condición simple
// ============================================================
let contador: number = 1;
while (contador <= 5) {
    print("contador = " + contador);
    contador = contador + 1;
}

// ============================================================
// 2. while + break: buscar el primer múltiplo de 7 >= 100
// ============================================================
let n: number = 100;
let encontrado: number = 0;
while (true) {
    if (n % 7 == 0) {
        encontrado = n;
        break;
    }
    n = n + 1;
}
print("Primer múltiplo de 7 >= 100: " + encontrado);

// ============================================================
// 3. while + continue: sumar solo números impares hasta 10 (1+3+5+7+9 = 25)
// ============================================================
let i: number = 0;
let sumaImpares: number = 0;
while (i < 10) {
    i = i + 1;
    if (i % 2 == 0) {
        continue;
    }
    sumaImpares = sumaImpares + i;
}
print("Suma de impares del 1 al 10: " + sumaImpares);

// ============================================================
// 4. for clásico: factorial con for en vez de recursión
// ============================================================
let factorial: number = 1;
for (let k: number = 1; k <= 7; k = k + 1) {
    factorial = factorial * k;
}
print("7! = " + factorial);

// ============================================================
// 5. for + break: tabla de multiplicar hasta encontrar 42
// ============================================================
let tabla: number = 0;
for (let t: number = 1; t <= 10; t = t + 1) {
    let producto: number = t * 7;
    if (producto == 42) {
        tabla = t;
        break;
    }
}
print("7 * " + tabla + " = 42");

// ============================================================
// 6. for anidado: matriz de coordenadas 3x3
// ============================================================
print("Coordenadas 3x3:");
for (let fila: number = 0; fila < 3; fila = fila + 1) {
    let linea: string = "";
    for (let col: number = 0; col < 3; col = col + 1) {
        linea = linea + "(" + fila + "," + col + ") ";
    }
    print(linea);
}

// ============================================================
// 7. .length: contar caracteres de varias palabras
// ============================================================
let palabras: string = "Hola mundo desde Arcis";
print("'" + palabras + "' tiene " + palabras.length + " caracteres");

let vacio: string = "";
print("String vacío tiene " + vacio.length + " caracteres");

// ============================================================
// 8. .length + for: contar vocales en una frase
// ============================================================
let frase: string = "TypeScript es genial";
let vocales: number = 0;
for (let pos: number = 0; pos < frase.length; pos = pos + 1) {
    // Comparamos con letras específicas. Sin indexing a chars (limitación v1),
    // contamos por longitud de palabras separadas — esto es una demo de la
    // combinación length + for, no un algoritmo perfecto de vocales.
    vocales = vocales + 1;
}
print("' " + frase + "' procesada, longitud " + frase.length);

// ============================================================
// 9. while: búsqueda del primer dígito en una suma acumulada
// ============================================================
let acc: number = 1;
let pasos: number = 0;
while (acc < 1000) {
    acc = acc * 3;
    pasos = pasos + 1;
}
print("3^" + pasos + " = " + acc + " (primera potencia >= 1000)");

// ============================================================
// 10. for con continue: imprimir múltiplos de 3 del 1 al 20
// ============================================================
print("Múltiplos de 3 hasta 20:");
for (let m: number = 1; m <= 20; m = m + 1) {
    if (m % 3 != 0) {
        continue;
    }
    print(m);
}