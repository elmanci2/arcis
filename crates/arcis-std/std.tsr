// arcis-std: top-level entry point.
//
// Re-exports the contents of every other module in the standard library so
// `import { trim, sum } from "std";` works without forcing users to learn the
// internal layout.
//
// Wiring this into the driver is part of phase 2 — once the driver learns
// to embed this crate's `.tsr` sources via `include_str!`.

import { trim, upper, lower } from "strings";
import { sum, average } from "arrays";
import { PI, E } from "math";

export { trim, upper, lower, sum, average, PI, E };
