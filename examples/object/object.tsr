// object.tsr — inline objects with named structs
// Covers: creation, reading, assignment, two distinct types.

// ============================================================
// 1. Simple object: two fields (string + number)
// ============================================================
let person: { name: string, age: number } = {
    name: "Ana",
    age: 30
};
print("Name: " + person.name);   // "Ana"
print("Age: " + person.age);     // 30

person.age = 31;
print("New age: " + person.age); // 31

// ============================================================
// 2. Object with three heterogeneous fields (string + number + boolean)
// ============================================================
let config: { debug: boolean, max: number, label: string } = {
    debug: false,
    max: 100,
    label: "main"
};
print("Label: " + config.label);   // "main"
print("Max: " + config.max);       // 100

config.debug = true;
print("Debug now: " + config.debug);   // true

// ============================================================
// 3. Objects as items inside arrays
// ============================================================
let points: { x: number, y: number }[] = [
    { x: 1, y: 2 },
    { x: 3, y: 4 },
    { x: 5, y: 6 }
];

for (let p of points) {
    print("Point: (" + p.x + ", " + p.y + ")");
}

// ============================================================
// 4. Sum the coordinates
// ============================================================
let totalX: number = 0;
let totalY: number = 0;
for (let p of points) {
    totalX = totalX + p.x;
    totalY = totalY + p.y;
}
print("Total X: " + totalX);   // 9
print("Total Y: " + totalY);   // 12

// ============================================================
// 5. Reassign fields on an element of an object array
// ============================================================
points[0].x = 100;
print("points[0].x = " + points[0].x);   // 100